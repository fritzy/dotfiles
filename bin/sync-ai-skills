#!/usr/bin/env python3
import filecmp
from pathlib import Path
import shutil
import sys
import tempfile


IGNORE = shutil.ignore_patterns('__pycache__', '*.pyc', '*.pyo', '.git')


def same(source, target):
    if target.is_symlink() or not target.is_dir():
        return False
    names = set(p.name for p in source.iterdir()) - set(IGNORE(str(source), [p.name for p in source.iterdir()]))
    existing = set(p.name for p in target.iterdir()) - set(IGNORE(str(target), [p.name for p in target.iterdir()]))
    if names != existing:
        return False
    for name in names:
        left, right = source / name, target / name
        if left.is_dir():
            if not same(left, right):
                return False
        elif right.is_symlink() or not right.is_file() or not filecmp.cmp(left, right, shallow=False) or (left.stat().st_mode & 0o777) != (right.stat().st_mode & 0o777):
            return False
    return True


def replace(source, target, backups):
    backups.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.skill-sync-', dir=target.parent) as temporary:
        staged = Path(temporary) / 'skill'
        shutil.copytree(source, staged, ignore=IGNORE)
        saved = None
        if target.exists() or target.is_symlink():
            saved = backups / target.name
            index = 1
            while saved.exists() or saved.is_symlink():
                saved = backups / f'{target.name}.{index}'
                index += 1
            target.rename(saved)
        try:
            staged.rename(target)
        except OSError:
            if saved is not None:
                saved.rename(target)
            raise
        if saved is not None:
            print(f'Backed up {target} to {saved}')


def sync(source, target):
    if not source.is_dir():
        return
    backups = target.parent / 'skill-backups'
    if target.is_symlink():
        if target.exists():
            replace(target.resolve(), target, backups)
        else:
            backups.mkdir(parents=True, exist_ok=True)
            saved = backups / 'skills-link'
            index = 1
            while saved.exists() or saved.is_symlink():
                saved = backups / f'skills-link.{index}'
                index += 1
            target.rename(saved)
    target.mkdir(parents=True, exist_ok=True)
    for skill in sorted(source.iterdir()):
        if skill.name.startswith('.') or not skill.is_dir():
            continue
        destination = target / skill.name
        if not same(skill, destination):
            replace(skill, destination, backups)


if __name__ == '__main__':
    if len(sys.argv) != 3:
        sys.exit('Usage: sync-ai-skills SOURCE TARGET')
    try:
        sync(Path(sys.argv[1]), Path(sys.argv[2]))
    except OSError as error:
        sys.exit(str(error))
