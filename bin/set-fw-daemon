#!/usr/bin/env python3
import os
from pathlib import Path
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]


def header(line):
    line = line.strip()
    if line.startswith('[') and line.endswith(']'):
        return [part.strip() for part in line[1:-1].split('.')]
    return None


def update(text, name, url):
    lines = text.splitlines()
    entry = f'url = {url}'
    start = next((i for i, line in enumerate(lines) if header(line) == ['daemons', name]), None)
    if start is None:
        while lines and not lines[-1].strip():
            lines.pop()
        lines += [*([''] if lines else []), f'[daemons.{name}]', entry]
        return '\n'.join(lines) + '\n'
    end = next((i for i in range(start + 1, len(lines)) if header(lines[i]) is not None), len(lines))
    for i in range(start + 1, end):
        key, equals, value = lines[i].partition('=')
        if equals and key.strip() == 'url':
            if value.strip() == url:
                return text
            lines[i] = entry
            break
    else:
        lines.insert(start + 1, entry)
    return '\n'.join(lines) + '\n'


def main():
    if len(sys.argv) != 3:
        sys.exit('Usage: set-fw-daemon NAME URL')
    name, url = sys.argv[1:]
    path = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'fritzworks/config.ini'
    if path.is_symlink() and not path.exists():
        sys.exit(f'Broken configuration link: {path}; restore its target before rerunning bootstrap.')
    target = path.resolve()
    # Stale Stow links would write machine-specific daemons into the tracked seed.
    if target.is_relative_to(ROOT):
        sys.exit(f'{path} links into the dotfiles checkout; replace it with a copy first.')
    exists = target.exists()
    # Start from the seed so a later bootstrap.sh, which seeds only absent files, loses nothing.
    seed = ROOT / 'home/.config/fritzworks/config.ini'
    text = target.read_text() if exists else seed.read_text() if seed.exists() else ''
    updated = update(text, name, url)
    if exists and updated == text:
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile('w', dir=target.parent, prefix='.config.ini.', delete=False) as file:
        file.write(updated)
    os.chmod(file.name, target.stat().st_mode & 0o777 if exists else 0o600)
    os.replace(file.name, target)
    print(f'Set [daemons.{name}] url = {url} in {path}; run fw daemon restart to load it.')


if __name__ == '__main__':
    try:
        main()
    except OSError as error:
        sys.exit(str(error))
