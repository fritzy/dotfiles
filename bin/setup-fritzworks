#!/usr/bin/env python3
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def run(*args, capture=False):
    return subprocess.run(args, check=True, text=True, stdout=subprocess.PIPE if capture else None).stdout


def setup():
    run('fw', 'config', 'validate')
    run('fw', 'setup', '--no-mcp', '--no-skills', '--no-commands', '--no-trust')
    for provider in ('claude', 'codex'):
        if not shutil.which(provider):
            continue
        if provider == 'codex':
            entries = json.loads(run('codex', 'mcp', 'list', '--json', capture=True))
            if not isinstance(entries, list):
                raise ValueError('Invalid Codex MCP listing')
            configured = any(entry.get('name') == 'fw' for entry in entries)
        else:
            custom = os.environ.get('CLAUDE_CONFIG_DIR')
            path = Path(custom) / 'claude.json' if custom else Path.home() / '.claude.json'
            document = json.loads(path.read_text()) if path.exists() else {}
            configured = 'fw' in document.get('mcpServers', {})
        if configured:
            print(f'Preserving existing {provider} fw MCP registration.')
            continue
        run('fw', 'setup', '--provider', provider, '--no-hooks', '--no-skills',
            '--no-shell', '--no-commands', '--no-trust')


if __name__ == '__main__':
    try:
        setup()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        sys.exit(str(error))
