Host workstation workstation-tunnel
  Hostname 127.0.0.1
  Port 22
  User nathan_fritz_chainguard_dev
  IdentityFile ~/.ssh/google_compute_engine
  IdentitiesOnly yes
  CheckHostIP no
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host workstation
  ProxyCommand exec "$HOME/.scripts/workstation-ssh-proxy" %h %p

Host workstation-tunnel
  ProxyCommand exec "$HOME/.scripts/workstation-ssh-proxy" %h %p --tunnel
  RemoteForward /tmp/url-open.sock /tmp/url-open.sock
  LocalForward 127.1.1.2:7337 127.0.0.1:7337
  RemoteForward 127.0.0.1:7441 127.0.0.1:7337
  ExitOnForwardFailure yes
  StreamLocalBindUnlink yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
