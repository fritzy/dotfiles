[Unit]
Description=xdg-open dispatcher (reads URLs from FIFO)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStartPre=/usr/bin/bash -c 'rm -f /tmp/url-open.fifo && mkfifo -m 0600 /tmp/url-open.fifo'
ExecStart=/home/nathan.fritz/.scripts/url-dispatch
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
