{
  "name": "@fritzy/ai-workstream",
  "version": "1.0.0",
  "type": "module",
  "description": "AI workstream manager for Git worktrees, Zellij, Claude Code, and Codex.",
  "bin": {
    "ws": "cli.js",
    "ws-mcp": "mcp.js"
  },
  "scripts": {
    "mcp": "node --no-warnings ./mcp.js",
    "test": "node --test",
    "check": "node --check cli.js && node --check mcp.js && node --check lib/config.js && node --check lib/core.js && node --check lib/zellij.js && node --test",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "cli.js",
    "mcp.js",
    "config.ini",
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fritzy/dotfiles.git",
    "directory": "packages/ai-workstream"
  },
  "homepage": "https://github.com/fritzy/dotfiles/tree/main/packages/ai-workstream#readme",
  "bugs": {
    "url": "https://github.com/fritzy/dotfiles/issues"
  },
  "author": "Nathanael C. Fritz",
  "license": "MIT",
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "git-worktree",
    "mcp",
    "zellij"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  }
}
