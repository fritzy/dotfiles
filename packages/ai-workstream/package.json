{
  "name": "@fritzy/ai-workstream",
  "version": "1.0.0",
  "type": "module",
  "description": "AI workstream manager for Git worktrees, Zellij, Claude Code, and Codex.",
  "bin": {
    "ws": "cli.js",
    "ws-mcp": "mcp.js"
  },
  "scripts": {
    "build:web:v2": "vite build",
    "dev:web:v2": "vite --host 127.0.0.1",
    "mcp": "node --no-warnings ./mcp.js",
    "serve": "node --no-warnings ./server.js",
    "test": "node --test",
    "check": "npm run build:web:v2 && node --check cli.js && node --check mcp.js && node --check server.js && node --check lib/config.js && node --check lib/core.js && node --check lib/notes-files.js && node --check lib/zellij.js && node --check lib/api.js && node --check lib/daemon.js && node --check lib/hooks.js && node --check lib/pty.js && node --check lib/terminal.js && node --check lib/suggestions.js && zsh -n shell/ai-workstream.zsh && node --test",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "cli.js",
    "mcp.js",
    "server.js",
    "config.ini",
    "lib/",
    "shell/",
    "web/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fritzy/dotfiles.git",
    "directory": "packages/ai-workstream"
  },
  "homepage": "https://github.com/fritzy/dotfiles/tree/main/packages/ai-workstream#readme",
  "bugs": {
    "url": "https://github.com/fritzy/dotfiles/issues"
  },
  "author": "Nathanael C. Fritz",
  "license": "MIT",
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "git-worktree",
    "mcp",
    "zellij"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "node-pty": "^1.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
